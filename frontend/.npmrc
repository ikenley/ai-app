# Supply chain hardening. Requires npm >= 12 (enforced via devEngines in package.json).

# Only install versions published at least 3 days ago.
# Malicious releases are typically detected and unpublished within hours.
min-release-age=3

# Only run install scripts (preinstall/install/postinstall) for packages approved
# in package.json "allowScripts". Unreviewed scripts fail the install.
# Manage approvals with `npm approve-scripts` / `npm deny-scripts`.
strict-allow-scripts=true

# Disallow dependencies fetched from git URLs, which bypass registry checks
# and the release-age window.
allow-git=none

# Fail on unknown keys in this file, so a typo or an older npm can't
# silently disable the settings above.
strict-npmrc=true

# Fail (rather than warn) on engine mismatches.
engine-strict=true

# Save exact versions rather than ^ranges.
save-exact=true

# Pin the registry explicitly.
registry=https://registry.npmjs.org/
