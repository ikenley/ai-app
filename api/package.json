{
  "name": "ai-app",
  "version": "1.0.0",
  "description": "Boilerplate for Typescript Node application",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "NODE_ENV=development node --watch src/index.ts",
    "start": "node src/index.ts",
    "run-job-runner": "node ./src/index-job-runner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-coverage": "vitest run --coverage",
    "test-api-lambda": "node ./src/test-api-lambda.ts",
    "test-job-runner": "node ./src/test-job-runner.ts",
    "check": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:write": "biome lint --write",
    "clean": "rm -rf dist build"
  },
  "author": "ikenley",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikenley/ai-app"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1149.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-ses": "^3.1149.0",
    "@aws-sdk/client-sfn": "^3.1149.0",
    "@aws-sdk/client-sqs": "^3.1149.0",
    "@aws-sdk/client-ssm": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@google/genai": "^2.28.0",
    "@vendia/serverless-express": "^4.12.6",
    "awilix": "^13.0.5",
    "aws-jwt-verify": "^5.2.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "method-override": "^3.0.0",
    "morgan": "^1.12.1",
    "openai": "^7.32.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/aws-lambda": "^8.10.164",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/method-override": "^3.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "5.0.2",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "protobufjs": false,
    "@google/genai": false,
    "fsevents": false
  }
}
