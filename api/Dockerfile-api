# syntax=docker/dockerfile:1

FROM node:26 AS build

WORKDIR /usr/src/app

# npm >= 12 is required by devEngines and the supply chain settings in .npmrc
RUN npm install -g npm@12.2.0

# Install app dependencies
COPY package*.json .npmrc ./
RUN npm ci

# Bundle app source
COPY . .
RUN npm run build

# This will use a minimal base image for the runtime
FROM node:26.1.0-alpine

WORKDIR /usr/src/app

EXPOSE 8080

RUN npm install -g npm@12.2.0

# Copy results from previous stage
COPY --from=build /usr/src/app/package*.json /usr/src/app/.npmrc ./
RUN npm ci --omit=dev
COPY --from=build /usr/src/app/dist ./dist

CMD [ "node", "dist/index.js" ]