# Docker image for Lambda entrypoint
# https://docs.aws.amazon.com/lambda/latest/dg/nodejs-image.html

FROM public.ecr.aws/lambda/nodejs:24.2026.10.22.03 AS builder

WORKDIR /usr/app

# npm >= 12 is required by devEngines and the supply chain settings in .npmrc
RUN npm install -g npm@12.2.0

# Install dependencies
COPY package*.json .npmrc ./
RUN npm ci

# Bundle app source code
COPY . ./
RUN npm run build 

# Minimal lambda runtime
FROM public.ecr.aws/lambda/nodejs:24.2026.10.22.03 AS runtime

WORKDIR ${LAMBDA_TASK_ROOT}

RUN npm install -g npm@12.2.0

# Install runtime dependencies
COPY --from=builder /usr/app/package*.json /usr/app/.npmrc ./
RUN npm ci --omit=dev

COPY --from=builder /usr/app/dist ./dist

ARG APP_VERSION
ENV APP_VERSION=$APP_VERSION
CMD ["dist/index-api-lambda.handler"]